PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/teamstreakpromo
JWT_SECRET=your_super_secret_jwt_key_here_for_teamstreakpromo
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_for_teamstreakpromo
JWT_REFRESH_EXPIRES_IN=7d

RESET_TOKEN_SECRET=your_super_secret_reset_jwt_key_here
RESET_TOKEN_EXPIRES_IN=15m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=TeamStreak Promo <noreply@teamstreakpromo.com>

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name